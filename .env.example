# Required: OAuth2 client credentials from Loopio Admin > Integrations > For Developers
LOOPIO_CLIENT_ID=
LOOPIO_CLIENT_SECRET=

# Optional: datacenter host (default api.loopio.com; api.int01.loopio.com for testing)
# LOOPIO_HOST=api.loopio.com
# LOOPIO_API_BASE_PATH=/data/v2

# Write gating. Read-write by default (write AND delete tools enabled); set
# LOOPIO_READ_ONLY=true to expose read tools only.
# LOOPIO_READ_ONLY=false

# Optional: override requested scopes (default derived from the flag above)
# LOOPIO_SCOPES=library:read project:read

# Optional: max results returned per list/search tool (default 200)
# LOOPIO_MAX_RESULTS=200

# --- HTTP transport (loopio-mcp-http) ---
# Port: LOOPIO_HTTP_PORT, else PORT (Azure App Service injects this), else 3000.
# LOOPIO_HTTP_PORT=3000
# Comma-separated Host allowlist. MUST include your public hostname when
# deployed (e.g. my-app.azurewebsites.net) or every request is rejected.
# LOOPIO_HTTP_ALLOWED_HOSTS=

# Proxy-auth: when true, require and log a forwarded identity from an
# authenticating reverse proxy (Azure Easy Auth, APIM, Keycloak, ...).
# Requests without a forwarded identity are rejected with 401.
# NOTE: the identity header is TRUSTED, not signature-verified. Only safe when
# the proxy strips inbound copies of it and is the sole network path to the
# server, else any caller can impersonate any user. Easy Auth handles both.
# LOOPIO_TRUST_PROXY_AUTH=false
# Identity header/claim overrides (defaults target Azure Easy Auth):
# LOOPIO_AUTH_PRINCIPAL_HEADER=x-ms-client-principal
# LOOPIO_AUTH_NAME_HEADER=x-ms-client-principal-name
# LOOPIO_AUTH_NAME_CLAIM=name
# LOOPIO_AUTH_ROLES_CLAIM=roles
