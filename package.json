{
  "name": "loopio-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (stdio) server wrapping the Loopio Data API v2.",
  "type": "module",
  "license": "MIT",
  "bin": { "loopio-mcp": "dist/server.js" },
  "files": ["dist"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "spec:fetch": "tsx scripts/fetch-loopio-spec.ts",
    "spec:types": "openapi-typescript specs/loopio-openapi.yaml -o src/loopio/openapi.generated.ts",
    "spec:update": "npm run spec:fetch && npm run spec:types"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
